<Window x:Class="DiaryOut.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiaryOut.App"
        mc:Ignorable="d"
        Title="DiaryOut - 你的日记导出工具" Width="760" Height="640"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <!-- 登录面板 -->
        <StackPanel x:Name="LoginPanel" VerticalAlignment="Center" Width="360"
                    HorizontalAlignment="Center">
            <TextBlock Text="登录 你的日记（nideriji.cn）" FontSize="18" FontWeight="Bold"
                       Margin="0,0,0,16" HorizontalAlignment="Center"/>
            <TextBlock Text="邮箱 / QQ号" Margin="0,0,0,4"/>
            <TextBox x:Name="EmailBox" Height="28" VerticalContentAlignment="Center"/>
            <TextBlock Text="密码" Margin="0,10,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="28" VerticalContentAlignment="Center"
                         KeyDown="PasswordBox_KeyDown"/>
            <Button x:Name="LoginButton" Content="登 录" Height="34" Margin="0,14,0,0"
                    Click="LoginButton_Click"/>
            <TextBlock x:Name="LoginStatusText" Foreground="#B00020" Margin="0,10,0,0"
                       TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 导出面板 -->
        <Grid x:Name="ExportPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部：用户信息 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button Content="退出登录" DockPanel.Dock="Right" Padding="10,4"
                        Click="LogoutButton_Click"/>
                <TextBlock x:Name="UserInfoText" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 输出目录 -->
                    <TextBlock Text="输出目录" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,4,0,10">
                        <Button Content="浏览…" DockPanel.Dock="Right" Padding="10,4"
                                Margin="6,0,0,0" Click="BrowseButton_Click"/>
                        <TextBox x:Name="OutputDirBox" Height="26" VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <!-- 导出范围 -->
                    <TextBlock Text="导出范围" FontWeight="SemiBold"/>
                    <StackPanel Margin="0,4,0,10">
                        <RadioButton x:Name="ScopeAllRadio" Content="全部日记" IsChecked="True"
                                     GroupName="Scope" Checked="ScopeRadio_Checked"/>
                        <RadioButton x:Name="ScopeDateRadio" Content="按日期范围" GroupName="Scope"
                                     Margin="0,4,0,0" Checked="ScopeRadio_Checked"/>
                        <DockPanel Margin="20,2,0,2">
                            <TextBlock Text="从" VerticalAlignment="Center"/>
                            <DatePicker x:Name="FromDatePicker" Width="120" Margin="6,0,12,0"/>
                            <TextBlock Text="到" VerticalAlignment="Center"/>
                            <DatePicker x:Name="ToDatePicker" Width="120" Margin="6,0,0,0"/>
                        </DockPanel>
                        <RadioButton x:Name="ScopeKeywordRadio" Content="按关键词搜索" GroupName="Scope"
                                     Margin="0,4,0,0" Checked="ScopeRadio_Checked"/>
                        <TextBox x:Name="KeywordBox" Margin="20,2,0,4" Height="26"
                                 VerticalContentAlignment="Center" ToolTip="匹配标题与正文"/>
                        <RadioButton x:Name="ScopeSelectedRadio" Content="手动勾选日记" GroupName="Scope"
                                     Checked="ScopeRadio_Checked"/>
                        <DockPanel Margin="20,2,0,0">
                            <Button Content="刷新列表" DockPanel.Dock="Right" Padding="10,2"
                                    Margin="6,0,0,0" Click="RefreshListButton_Click"/>
                            <Button Content="全选/清空" DockPanel.Dock="Right" Padding="10,2"
                                    Click="ToggleAllButton_Click"/>
                        </DockPanel>
                        <ListBox x:Name="DiaryListBox" Height="150" Margin="20,4,0,0"
                                 DisplayMemberPath="Display"/>
                    </StackPanel>

                    <!-- 导出格式 -->
                    <TextBlock Text="导出格式" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,4,0,10">
                        <CheckBox x:Name="HtmlBox" Content="HTML" IsChecked="True" Margin="0,0,16,0"/>
                        <CheckBox x:Name="MarkdownBox" Content="Markdown" IsChecked="True" Margin="0,0,16,0"/>
                        <CheckBox x:Name="PdfPerDiaryBox" Content="单篇 PDF" Margin="0,0,16,0"/>
                        <CheckBox x:Name="MergedPdfBox" Content="合并 PDF"/>
                    </WrapPanel>

                    <!-- 日志 -->
                    <TextBlock Text="日志" FontWeight="SemiBold"/>
                    <TextBox x:Name="LogBox" Margin="0,4,0,0" Height="110" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部：进度与操作 -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ProgressBar x:Name="ExportProgress" Height="10" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressText" FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="OpenFolderButton" Grid.Column="1" Content="打开目录" Padding="12,6"
                        Margin="0,0,8,0" IsEnabled="False" Click="OpenFolderButton_Click"/>
                <Button x:Name="CancelButton" Grid.Column="2" Content="取消" Padding="12,6"
                        Margin="0,0,8,0" IsEnabled="False" Click="CancelButton_Click"/>
                <Button x:Name="StartButton" Grid.Column="3" Content="开始导出" Padding="16,6"
                        FontWeight="SemiBold" Click="StartButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
